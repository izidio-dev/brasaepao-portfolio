rules_version = '2';

// Regras de segurança do projeto Firebase "demos-rafael".
// ATENÇÃO: o Firebase usa UM arquivo de regras para o projeto inteiro,
// então este arquivo cobre as duas lojas de demonstração:
//   - lojas/brasa  (Brasa & Pão — hamburgueria), produtos, adicionais e promocoes
//   - lojas/atelie (Ateliê Norte — loja de roupas), pedidos e clientes/{uid}
// Qualquer visitante pode LER; só o dono (UID em donos()) pode ALTERAR.
// Tudo que não estiver listado aqui fica fechado.
service cloud.firestore {
  match /databases/{database}/documents {

    // UID da conta do gerente (Firebase Console → Authentication → Usuários).
    function donos() {
      return ['L20y3b6TQXOwBmOjvUE6DdPQn122'];
    }

    function ehDono() {
      return request.auth != null && request.auth.uid in donos();
    }

    function textoOk(campo, max) {
      return campo is string && campo.size() > 0 && campo.size() <= max;
    }

    function precoOk(valor) {
      return valor is int && valor >= 0 && valor <= 1000000;
    }

    function whatsappOk(numero) {
      return numero is string && numero.matches('^[0-9]{12,13}$');
    }

    // ---------- Brasa & Pão ----------
    function lojaBrasaValida(d) {
      return textoOk(d.nome, 80) && whatsappOk(d.whatsapp)
        && precoOk(d.taxaEntrega) && textoOk(d.tempoEntrega, 40);
    }

    function produtoValido(d) {
      return textoOk(d.nome, 80)
        && d.descricao is string && d.descricao.size() <= 300
        && precoOk(d.preco)
        && d.categoria in ['burgers', 'combos', 'acompanhamentos', 'bebidas']
        && d.foto is string && d.foto.size() <= 250000
        && d.disponivel is bool
        && d.ordem is number
        && (!('promocao' in d) || promocaoProdutoValida(d.promocao, d.preco));
    }

    function dataOk(t) {
      return t is string && t.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$');
    }

    // Preço promocional de um produto: menor que o preço normal, com data de fim.
    function promocaoProdutoValida(p, precoNormal) {
      return p is map && p.keys().hasOnly(['preco', 'ate']) && p.keys().hasAll(['preco', 'ate'])
        && precoOk(p.preco) && p.preco < precoNormal && dataOk(p.ate);
    }

    // Kit promocional: 1 a 6 itens (produto + quantidade), preço do kit e data de fim.
    function itemKitOk(itens, i) {
      return itens.size() <= i
        || (itens[i] is map && itens[i].keys().hasOnly(['produtoId', 'quantidade'])
            && textoOk(itens[i].produtoId, 80)
            && itens[i].quantidade is int && itens[i].quantidade >= 1 && itens[i].quantidade <= 10);
    }

    function kitValido(d) {
      return d.keys().hasOnly(['nome', 'descricao', 'itens', 'preco', 'ate', 'ativo', 'ordem'])
        && d.keys().hasAll(['nome', 'descricao', 'itens', 'preco', 'ate', 'ativo', 'ordem'])
        && textoOk(d.nome, 80)
        && d.descricao is string && d.descricao.size() <= 200
        && d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 6
        && itemKitOk(d.itens, 0) && itemKitOk(d.itens, 1) && itemKitOk(d.itens, 2)
        && itemKitOk(d.itens, 3) && itemKitOk(d.itens, 4) && itemKitOk(d.itens, 5)
        && precoOk(d.preco) && dataOk(d.ate)
        && d.ativo is bool && d.ordem is number;
    }

    function adicionalValido(d) {
      return textoOk(d.nome, 60) && precoOk(d.preco) && d.ordem is number;
    }

    match /lojas/brasa {
      allow read: if true;
      allow write: if ehDono() && lojaBrasaValida(request.resource.data);

      match /produtos/{id} {
        allow read: if true;
        allow create, update: if ehDono() && produtoValido(request.resource.data);
        allow delete: if ehDono();
      }

      match /adicionais/{id} {
        allow read: if true;
        allow create, update: if ehDono() && adicionalValido(request.resource.data);
        allow delete: if ehDono();
      }

      match /promocoes/{id} {
        allow read: if true;
        allow create, update: if ehDono() && kitValido(request.resource.data);
        allow delete: if ehDono();
      }
    }

    // ---------- Ateliê Norte ----------
    function lojaAtelieValida(d) {
      return textoOk(d.nome, 80) && whatsappOk(d.whatsapp)
        && d.instagram is string && d.instagram.size() <= 40
        && d.aviso is string && d.aviso.size() <= 200
        // Até 3 banners; o documento inteiro tem limite de 1 MB no Firestore.
        && (!('banners' in d) || (d.banners is list && d.banners.size() <= 3));
    }

    // As regras não percorrem listas, então validamos a primeira cor e o tamanho
    // da lista; o painel valida todas as cores antes de salvar.
    function varianteValida(v) {
      return textoOk(v.cor, 40)
        && v.hex is string && v.hex.matches('^#[0-9a-fA-F]{6}$')
        && v.fotos is list && v.fotos.size() >= 1 && v.fotos.size() <= 3
        && v.tamanhos is list && v.tamanhos.size() > 0 && v.tamanhos.hasOnly(['PP', 'P', 'M', 'G', 'GG']);
    }

    function pecaValida(d) {
      return textoOk(d.nome, 80)
        && d.descricao is string && d.descricao.size() <= 400
        && d.categoria in ['vestidos', 'blusas', 'calcas', 'saias', 'casacos']
        && precoOk(d.preco)
        && (!('precoPromocional' in d) || (precoOk(d.precoPromocional) && d.precoPromocional < d.preco))
        && d.variantes is list && d.variantes.size() >= 1 && d.variantes.size() <= 4
        && varianteValida(d.variantes[0])
        && (d.variantes.size() < 2 || varianteValida(d.variantes[1]))
        && (d.variantes.size() < 3 || varianteValida(d.variantes[2]))
        && (d.variantes.size() < 4 || varianteValida(d.variantes[3]))
        && d.disponivel is bool
        && (!('novidade' in d) || d.novidade is bool)
        && d.ordem is number;
    }

    function pedidoValido(d) {
      return d.keys().hasOnly(['clienteUid', 'clienteNome', 'itens', 'total', 'entrega', 'status', 'criadoEm'])
        && d.clienteUid == request.auth.uid
        && textoOk(d.clienteNome, 80)
        && d.itens is list && d.itens.size() >= 1 && d.itens.size() <= 30
        && precoOk(d.total)
        && d.entrega in ['retirada', 'entrega']
        && d.status == 'enviado'
        && d.criadoEm == request.time;
    }

    match /lojas/atelie {
      allow read: if true;
      allow write: if ehDono() && lojaAtelieValida(request.resource.data);

      match /pecas/{id} {
        allow read: if true;
        allow create, update: if ehDono() && pecaValida(request.resource.data);
        allow delete: if ehDono();
      }

      // Pedidos: o cliente registra o próprio; lê só os seus. A dona lê todos
      // e muda apenas o status. Ninguém apaga (registro de venda).
      match /pedidos/{id} {
        allow create: if request.auth != null && pedidoValido(request.resource.data);
        allow read: if request.auth != null && (resource.data.clienteUid == request.auth.uid || ehDono());
        allow update: if ehDono()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['enviado', 'confirmado', 'a caminho', 'entregue', 'cancelado'];
      }
    }

    // ---------- Conta do cliente (Ateliê Norte) ----------
    // Coleta mínima: sem CPF nem data de nascimento. Só o próprio cliente acessa.
    function clienteValido(d) {
      return d.keys().hasOnly(['nome', 'telefone', 'enderecos', 'favoritos', 'aceitePrivacidade'])
        && textoOk(d.nome, 80)
        && d.telefone is string && d.telefone.size() <= 20
        && d.enderecos is list && d.enderecos.size() <= 3
        && d.favoritos is list && d.favoritos.size() <= 100
        && d.aceitePrivacidade is string && d.aceitePrivacidade.size() > 0;
    }

    match /clientes/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && clienteValido(request.resource.data);
    }
  }
}
